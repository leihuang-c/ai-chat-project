# app.env - 环境变量模板
# 此文件用于版本控制，真实值在部署时由 GitHub Secrets 注入

# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ai_chat_system
DB_USER=root
DB_PASSWORD=${DB_PASSWORD}

# 服务发现
#NACOS_SERVER=18.144.11.177:8848
#NACOS_NAMESPACE=public

# 应用端口
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
CHAT_SERVICE_PORT=8082

# DEEPSEEK API KEY
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}