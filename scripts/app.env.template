# ====================
# 数据库配置
# ====================
DB_NAME=ai_chat_system
DB_PASSWORD=your_secure_password_here

# ====================
# 服务发现配置
# ====================
NACOS_SERVER=18.144.11.177:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# ====================
# 应用端口配置
# ====================
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
CHAT_SERVICE_PORT=8082
FRONTEND_PORT=3000

# ====================
# Spring 配置
# ====================
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ai_chat_system?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# ====================
# 服务 URL 配置
# ====================
USER_SERVICE_URL=http://user-service:8081
CHAT_SERVICE_URL=http://chat-service:8082

# ====================
# AI 服务配置
# ====================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=deepseek-chat

# ====================
# 前端配置
# ====================
NODE_ENV=production
FRONTEND_API_BASE_URL=http://localhost:8080
FRONTEND_API_VERSION=v1
FRONTEND_APP_NAME=AI Chat Assistant
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ====================
# 日志配置
# ====================
LOGGING_LEVEL_COM_AI_CHAT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOGGING_LEVEL_ORG_HIBERNATE=ERROR